{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Atlas (诸象) — cross-tradition divination app",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:mobile": "npm --prefix apps/mobile run start",
    "dev:web": "npm run dev -w @atlas/web",
    "build:web": "npm run build -w @atlas/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "corpus:generate": "npm run generate -w @atlas/corpus-scripts",
    "corpus:validate": "npm run validate -w @atlas/corpus-scripts",
    "corpus:ingest": "npm run ingest -w @atlas/corpus-scripts",
    "corpus:ingest:dry-run": "npm run ingest:dry-run -w @atlas/corpus-scripts",
    "corpus:publish": "npm run publish -w @atlas/corpus-scripts",
    "corpus:embed": "npm run embed -w @atlas/corpus-scripts",
    "corpus:embed:dry-run": "npm run embed:dry-run -w @atlas/corpus-scripts"
  },
  "engines": { "node": ">=20.19.4" },
  "overrides": {
    "@atlas/web": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "@types/react": "^18.3.12"
    },
    "@atlas/mobile": {
      "react": "19.1.0",
      "@types/react": "~19.1.2"
    },
    "@expo/vector-icons": {
      "react-native": "0.81.5",
      "@types/react": "~19.1.2"
    }
  }
}
