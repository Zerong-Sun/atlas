{
  "name": "atlas",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "atlas",
      "version": "0.1.0",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "apps/mobile": {
      "name": "@atlas/mobile",
      "version": "0.1.0"
    },
    "node_modules/@atlas/corpus-scripts": {
      "resolved": "packages/corpus-scripts",
      "link": true
    },
    "node_modules/@atlas/engines": {
      "resolved": "packages/engines",
      "link": true
    },
    "node_modules/@atlas/mobile": {
      "resolved": "apps/mobile",
      "link": true
    },
    "node_modules/@atlas/shared-types": {
      "resolved": "packages/shared-types",
      "link": true
    },
    "packages/corpus-scripts": {
      "name": "@atlas/corpus-scripts",
      "version": "0.1.0"
    },
    "packages/engines": {
      "name": "@atlas/engines",
      "version": "0.1.0"
    },
    "packages/shared-types": {
      "name": "@atlas/shared-types",
      "version": "0.1.0"
    }
  }
}
